<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="camera_mount" params="prefix parent">
    <link name="${prefix}camera_mount">
      <visual>
        <geometry>
          <mesh filename="package://prismatic_fr3_duo_description/meshes/d405_mount.stl" scale=".001 .001 .001"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <box size="0.12 0.06 0.065"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="${prefix}camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}camera_mount"/>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>

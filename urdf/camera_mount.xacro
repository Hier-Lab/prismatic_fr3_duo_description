<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="camera_mount" params="prefix parent">
    <link name="${prefix}camera_mount">
      <visual>
        <geometry>
          <mesh filename="package://prismatic_fr3_duo_description/meshes/d405_mount.stl" scale=".001 .001 .001"/>
        </geometry>
        <material name="mount_black">
          <color rgba="0.05 0.05 0.05 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.0739 0 0.0245" rpy="0 0 0"/>
        <geometry>
          <box size="0.1178 0.060 0.0641"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.0739 0 0.0245" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia
          ixx="${0.05/12*(0.060*0.060 + 0.0641*0.0641)}" ixy="0" ixz="0"
          iyy="${0.05/12*(0.1178*0.1178 + 0.0641*0.0641)}" iyz="0"
          izz="${0.05/12*(0.1178*0.1178 + 0.060*0.060)}"/>
      </inertial>
    </link>
    <joint name="${prefix}camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}camera_mount"/>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}d405">
      <visual>
        <origin xyz="-0.01 0 0.023" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://prismatic_fr3_duo_description/meshes/d405.stl" scale="1 1 1"/>
        </geometry>
        <material name="d405_original">
          <color rgba="0.996078 0.996078 1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="-0.01 0 0.0115" rpy="0 0 0"/>
        <geometry>
          <box size="0.042 0.042 0.023"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.01 0 0.0115" rpy="0 0 0"/>
        <mass value="0.027"/>
        <inertia
          ixx="${0.027/12*(0.042*0.042 + 0.023*0.023)}" ixy="0" ixz="0"
          iyy="${0.027/12*(0.042*0.042 + 0.023*0.023)}" iyz="0"
          izz="${0.027/12*(0.042*0.042 + 0.042*0.042)}"/>
      </inertial>
    </link>
    <joint name="${prefix}d405_joint" type="fixed">
      <parent link="${prefix}camera_mount"/>
      <child link="${prefix}d405"/>
      <origin xyz="-0.125313 -0.0015 0.0360858" rpy="0.785398 0 1.5708"/>
    </joint>
  </xacro:macro>
</robot>

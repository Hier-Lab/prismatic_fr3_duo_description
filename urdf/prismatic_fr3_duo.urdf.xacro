<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prismatic_fr3_duo">

  <xacro:include filename="./prismatic_fr3_duo.xacro"/>
  <xacro:include filename="./camera_mount.xacro"/>
  <xacro:include filename="./soft_gripper_finger.xacro"/>

  <xacro:arg name="config_file" default="../config/prismatic_fr3_duo.yaml"/>
  <xacro:property name="params" value="${xacro.load_yaml('$(arg config_file)')}"/>

  <xacro:if value="${params['gazebo']}">
    <link name="world"/>
    <joint name="world_joint" type="fixed">
      <origin xyz="${params['xyz']}" rpy="${params['rpy']}"/>
      <parent link="world"/>
      <child link="rail_link"/>
    </joint>
  </xacro:if>

  <xacro:prismatic_fr3_duo
    robot_types="${params['robot_types']}"
    hand="${params['hand']}"
    ee_id="${params['ee_id']}"
    special_connection="${params['special_connection']}"
    xyz_ee="${params['xyz_ee']}"
    rpy_ee="${params['rpy_ee']}"
    tcp_xyz="${params['tcp_xyz']}"
    tcp_rpy="${params['tcp_rpy']}"
    safety_distance="${params['safety_distance']}"
    with_sc="${params['with_sc']}"
    gazebo="${params['gazebo']}"
    description_pkg="${params['description_pkg']}"
    arm_prefixes="${params['arm_prefixes']}"
    no_prefix="${params['no_prefix']}"/>


  <xacro:camera_mount prefix="left_" parent="left_fr3_hand"/>
  <xacro:camera_mount prefix="right_" parent="right_fr3_hand"/>

  <xacro:soft_gripper_finger suffix="left_fr3_leftfinger" parent="left_fr3_leftfinger"
    xyz="0.0129 0 0.0362" rpy="3.1420 0 1.5521"/>
  <xacro:soft_gripper_finger suffix="left_fr3_rightfinger" parent="left_fr3_rightfinger"
    xyz="0.0129 0 0.0362" rpy="3.1420 0 1.5521"/>

</robot>
